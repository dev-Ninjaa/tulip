<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!--
      Cleartext (HTTP) is permitted globally to support local Ollama servers
      on private LAN IPs (e.g. 192.168.x.x, 10.x.x.x).
      All external AI calls (Gemini) use HTTPS and are unaffected.
      Android's <domain> tag does not support IP subnet wildcards, so
      a base-config allowance is the correct approach for raw IP addresses.
    -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
