# Tulip Local AI Routing Configuration

# Router Server Port (default: 8787)
PORT=8787

# Upstream Ollama Server Host (default: http://127.0.0.1:11434)
OLLAMA_HOST=http://127.0.0.1:11434

# Required Ollama Model (default: gemma3:4b)
MODEL_NAME=gemma3:4b

# Maximum HTTP request body size (default: 20mb)
MAX_BODY_SIZE=20mb

# Upstream request timeout in milliseconds (default: 120000 = 2 minutes)
REQUEST_TIMEOUT_MS=120000

# Optional Pairing Token for simple client authentication (leave empty to disable)
PAIRING_TOKEN=
